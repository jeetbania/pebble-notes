 <TextView android:id="@+id/widget_feature_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="19sp" android:textStyle="bold" android:textColor="#24211C" android:maxLines="2" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_feature_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:textSize="14sp" android:lineSpacingExtra="2dp" android:textColor="#5B5750" android:ellipsize="end" android:maxLines="8"/>
</LinearLayout>